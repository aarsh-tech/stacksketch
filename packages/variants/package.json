{
  "name": "@stacksketch/variants",
  "version": "0.5.0",
  "description": "Render every prop combination of your React components on one page: a Vite plugin and a Next.js config wrapper, with props read from TypeScript.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./vite": "./dist/vite.js",
    "./next": "./dist/next.js",
    "./canvas": { "types": "./src/canvas.tsx", "default": "./dist/canvas.js" },
    "./mount": { "types": "./src/mount.tsx", "default": "./dist/mount.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture": "pnpm build && vite fixture"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "typescript": ">=5"
  },
  "devDependencies": {
    "@stacksketch/core": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.5"
  }
}
