{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "dist/types",
    // the published types carry the few core types they use, made by build.mjs first
    "paths": { "@stacksketch/core": ["./dist/types/core.d.ts"] }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
